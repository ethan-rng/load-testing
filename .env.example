# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- What to test ---
# Base URL of the app under test. Production (hackwestern.com) is refused.
TARGET=http://localhost:3000
# naive (default) or realistic (not built yet)
MODE=naive
# before | during | after. Only used by realistic mode.
PHASE=during
# Hosts besides localhost that may be tested, comma separated.
ALLOWED_HOSTS=dev.hackwestern.com

# --- Load shape ---
VUS=10
DURATION=30s
RAMP_UP=10s
# Set to true to allow mutations (POST calls). Off by default.
ALLOW_MUTATIONS=false

# --- Login (until seeded users exist, one account is used) ---
TEST_EMAIL=
TEST_PASSWORD=

# --- App map (/api/docs/app) ---
# Defaults to TARGET. Can point somewhere else, e.g. https://hackwestern.com
DOCS_ROOT=
DOCS_TOKEN=


# --- Web UI server (npm run server) ---
# Base URLs the UI may launch tests against, comma separated. Production is refused at startup.
ALLOWED_TARGETS=https://dev.hackwestern.com
PORT=8080
# Where the UI keeps its data (defaults shown). Profiles are SQLite; uploads go in IMPORTS_DIR.
# PROFILES_DB=data/profiles.db
# IMPORTS_DIR=data/imports
# DATA_DIR=data

# github = real sign-in (below). none = local only, no login, binds to 127.0.0.1.
AUTH_MODE=none

# --- GitHub sign-in (needed when AUTH_MODE=github) ---
# Public address of this UI. https required unless it's localhost.
PUBLIC_URL=
# Create an OAuth App (GitHub > Settings > Developer settings > OAuth Apps):
#   Homepage URL = PUBLIC_URL, Authorization callback URL = PUBLIC_URL/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ORG=hackwestern
# Only members of this team can launch or stop runs. Other org members can view.
LAUNCH_TEAM=hw13-web
# At least 32 characters: openssl rand -hex 32
SESSION_SECRET=
# Hours before people must sign in again (also how long a removal from the org takes to apply).
SESSION_HOURS=4
