# Copy to .env and fill in. .env is gitignored. Never commit real values.

# --- What to test ---
# Base URL of the app under test. Production (hackwestern.com) is refused.
TARGET=http://localhost:3000
# naive (default) or realistic (not built yet)
MODE=naive
# before | during | after. Only used by realistic mode.
PHASE=during
# Hosts besides localhost that may be tested, comma separated.
ALLOWED_HOSTS=dev.hackwestern.com

# --- Load shape ---
VUS=10
DURATION=30s
RAMP_UP=10s
# Set to true to allow mutations (POST calls). Off by default.
ALLOW_MUTATIONS=false

# --- Login (until seeded users exist, one account is used) ---
TEST_EMAIL=
TEST_PASSWORD=

# --- App map (/api/docs/app) ---
# Defaults to TARGET. Can point somewhere else, e.g. https://hackwestern.com
DOCS_ROOT=
DOCS_TOKEN=
